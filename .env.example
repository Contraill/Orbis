# Orbis V1: single backend worker; SQLite and /config must be persistent.
APP_ENV=production
APP_NAME="Orbis"
BUILD_ID=1.0.0
PROVIDER_OPERATION_TIMEOUT_SECONDS=15

# Required: obtain your own key from TMDB; never commit the real value.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Database
DATABASE_URL=sqlite:////data/orbis.db
